# Backend / Render API
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://<your-frontend>.onrender.com

# Razorpay TEST keys (backend only — never expose the secret to Vite/frontend)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
# Optional but recommended for production webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# OneSignal Web Push (backend secrets + frontend public App ID)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
ONESIGNAL_ADMIN_EXTERNAL_ID=your-admin-user-id
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id

# WhatsApp Cloud API — create an approved template with 5 body variables
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ADMIN_NUMBER=919XXXXXXXXX
WHATSAPP_ORDER_TEMPLATE=new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Frontend / Render Static Site
VITE_API_URL=https://<your-api>.onrender.com

# Only required if Supabase is actually used by the frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
